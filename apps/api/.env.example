# Copy this file to `.env` and replace the placeholders with your real values.

# Connection string for PostgreSQL (>= 15). Optional — without it the API uses
# in-memory stores seeded from the curated dataset.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# --- Agora RTC -------------------------------------------------------------
# Used to sign tokens for the live video room. Without these a demo token is
# issued and the room runs in local/text mode.
AGORA_APP_ID=""
AGORA_APP_CERTIFICATE=""

# --- Agora Agent Tools (Conversational AI interviewers) --------------------
# Point these at your conversational-agent gateway/function to run LIVE voice
# interviewers. Until configured, agent start returns a simulated payload and
# the interview runs through the transcript engine.
AGORA_AGENT_ENDPOINT=""     # e.g. https://your-agent-gateway.example.com
AGORA_AGENT_ID=""           # identifier of the agent to join the channel
AGORA_AGENT_KEY=""          # secret used to authenticate to your gateway
AGORA_AGENT_TTS_VOICE=""    # optional voice override (default en-US-Studio-Multilingual)
AGORA_AGENT_LLM_PROVIDER="" # optional (default openai)
AGORA_AGENT_LLM_MODEL=""    # optional (default gpt-4o-mini)

# --- Auth ------------------------------------------------------------------
JWT_SECRET="the-best-and-the-strongest-jwt-secret-which-can-never-be-hacked"
