# Copy this file to `.env` and replace the placeholders with your real values.

# Connection string for PostgreSQL (>= 15). Optional — without it the API uses
# in-memory stores seeded from the curated dataset.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# --- Gemini (real AI generation) -------------------------------------------
# Set this and every "mock" generation (goal structure, quick interviews,
# adaptive replies, evaluation, experience parsing) runs through Gemini.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"

# --- Agora RTC -------------------------------------------------------------
# Signs tokens for the live video room. Without these a demo token is issued.
AGORA_APP_ID=""
AGORA_APP_CERTIFICATE=""

# --- Agora Agent Tools (live voice interviewers) ---------------------------
# Option 1 — official Conversational AI Agents REST API:
AGORA_CUSTOMER_ID=""          # Agora Console > RESTful API > Customer ID
AGORA_CUSTOMER_SECRET=""      # Agora Console > RESTful API > Customer Secret
# Option 2 — your own agent gateway implementing /start and /stop:
AGORA_AGENT_ENDPOINT=""       # e.g. https://your-agent-gateway.example.com
AGORA_AGENT_KEY=""            # secret used to authenticate to your gateway
AGORA_AGENT_ID=""             # identifier of the agent (uid / app id) to join
# Agent tuning (optional):
AGORA_AGENT_TTS_PROVIDER="microsoft"
AGORA_AGENT_TTS_VOICE=""      # default en-US-Studio-Multilingual
AGORA_AGENT_LLM_PROVIDER="google"
AGORA_AGENT_LLM_MODEL="gemini-2.0-flash"

# --- Auth ------------------------------------------------------------------
JWT_SECRET="change-me-to-a-long-random-string"
